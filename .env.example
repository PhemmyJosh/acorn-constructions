#
# Acorn Construction: environment configuration
#
# Copy this file to `.env.local` and fill in real values:
#     cp .env.example .env.local
#
# Next.js loads `.env.local` automatically and it is already gitignored, so
# secrets never get committed. None of these are NEXT_PUBLIC_*, so none of
# them are exposed to the browser.
#

# ---------------------------------------------------------------------------
# Public base URL
# ---------------------------------------------------------------------------
# Used to build the absolute "View in Dashboard" link in notification emails.
# Must be the real production domain once there is one, otherwise Mark's email
# will link to a localhost address that only works on a dev machine.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# How many proxies sit between the internet and this app. Rate limiting keys on
# the client IP taken from X-Forwarded-For, read from the right-hand end,
# stepping left one entry per trusted hop.
#
# 1 is correct for a normal Hostinger Node app and is the default if unset, so
# this usually does not need setting at all. Only raise it if you knowingly add
# another hop, e.g. Cloudflare in front of Hostinger.
#
# Setting it HIGHER than the real number of hops lets a visitor forge their own
# IP and bypass the limits entirely. Setting it LOWER makes every visitor look
# like the proxy, so one attacker's failed logins lock everyone out.
TRUSTED_PROXY_COUNT=1

# ---------------------------------------------------------------------------
# Cloudflare R2 (project photo storage)
# ---------------------------------------------------------------------------
# Project photos uploaded through /admin are stored in an R2 bucket, NOT on the
# server's disk. Hostinger rebuilds into a fresh directory on every deploy, so
# anything written to disk at runtime is lost at the next deploy.
#
# Set up in the Cloudflare dashboard:
#   1. R2 Object Storage > Create bucket            -> R2_BUCKET_NAME
#   2. The bucket's Settings > Public Development URL, enabled
#                                                   -> R2_PUBLIC_URL
#   3. R2 > API > Manage API tokens > Create API token,
#      permission "Object Read & Write", scoped to that bucket
#        Access Key ID                              -> R2_ACCESS_KEY_ID
#        Secret Access Key (shown once)             -> R2_SECRET_ACCESS_KEY
#        The hex string in the endpoint host        -> R2_ACCOUNT_ID
#
# R2_PUBLIC_URL is also read at BUILD time, to allow the hostname through
# next/image (see next.config.ts) — it must be set in the build environment.
#
# If any of these is missing, photo uploads fail with a clear message rather
# than silently falling back to local disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
# Local development points at your own MySQL instance. On Hostinger, replace
# these with the values from hPanel > Databases > Management (the host is
# usually "localhost" there too, and the user/database names are prefixed,
# e.g. u123456789_acorn).
#
# Create the database, then load the schema:
#     mysql -u root -p -e "CREATE DATABASE acorn_construction"
#     mysql -u root -p acorn_construction < schema.sql
DB_HOST=localhost
# ---------------------------------------------------------------------------
# LOCAL ONLY, and only for the portable (unzipped, not installed) MySQL used in
# development: the folder containing its `server/` and `data/` directories.
# `node scripts/mysql-local.mjs start|stop|status` reads it to find mysqld.
#
# Leave unset on Hostinger — production MySQL is managed by the host and this
# variable is ignored there.
#
# Must NOT be under a temp path. It used to be, and Windows pruned the folder
# mid-session, destroying two tables' data files. See LOCAL-DEV.md.
LOCAL_MYSQL_HOME=
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=acorn_construction

# Maximum simultaneous MySQL connections. Kept low on purpose: shared hosting
# caps concurrent connections per database, and exhausting that cap takes the
# whole site down rather than just slowing it. Check Hostinger's stated limit
# (hPanel > Databases) before raising this. Defaults to 5 if unset.
DB_POOL_MAX=5

# ---------------------------------------------------------------------------
# SMTP email notifications
# ---------------------------------------------------------------------------
# LEAVE SMTP_* BLANK DURING DEVELOPMENT. When SMTP_HOST is empty the app
# creates a throwaway Ethereal test inbox on the fly and prints a preview URL
# to the server console for every email it "sends", so you can open the
# message in a browser without configuring a real mail server.
#
# For production, fill these in with real credentials. Hostinger's Titan mail
# is typically smtp.hostinger.com on port 465.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Where submission notifications are delivered.
#
# One address, or several separated by commas — every address listed receives
# each notification:
#     NOTIFY_EMAIL=mark@acornconstruction.ca
#     NOTIFY_EMAIL=mark@acornconstruction.ca,notifications@acornconstruction.ca
#
# Whitespace around each address is trimmed and duplicates are ignored. An
# entry with no "@" is skipped with a warning rather than sent, so one typo
# cannot make the mail server refuse the message for everybody.
#
# When SMTP_USER is not set, the FIRST address here is also used as the From
# address (a From header must be a single mailbox).
NOTIFY_EMAIL=mark@acornconstruction.ca

# ---------------------------------------------------------------------------
# Admin dashboard
# ---------------------------------------------------------------------------
#
# !! PRODUCTION VALUES MUST BE GENERATED FRESH IN HOSTINGER'S ENVIRONMENT
# !! VARIABLE SETTINGS. Never copy ADMIN_PASSWORD or ADMIN_SESSION_SECRET out
# !! of a local .env.local into production, and never the other way round. A
# !! local development secret has been on a dev machine, in shell history and
# !! in editor state; treat it as already compromised. Generate new ones at
# !! deploy time and store them only in a password manager. See DEPLOYMENT.md.
# Single shared password for /admin. Pick something long and random. The
# password itself is never sent to the browser or stored in the cookie; the
# session cookie holds an HMAC derived from it.
ADMIN_PASSWORD=change-me-before-deploying

# Secret used to sign the admin session cookie. Generate one with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left blank, ADMIN_PASSWORD is used as the signing key as a fallback.
ADMIN_SESSION_SECRET=
